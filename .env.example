# Copy to .env.local and fill in. NEVER commit .env.local.
# Supabase Dashboard → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS entirely. Seed scripts and token-protected admin
# routes only — never in a Server Component, never prefixed NEXT_PUBLIC_,
# never logged.
SUPABASE_SERVICE_ROLE_KEY=

# Google Cloud Console. Restrict to HTTP referrers matching the Render domain
# and localhost before using it anywhere.
NEXT_PUBLIC_MAPS_KEY=

# Blog draft generation (Phase 7).
ANTHROPIC_API_KEY=

# Bearer token for /api/trip/export and /api/trip/replan — the fallback path
# when the MCP server will not start. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TRIP_API_TOKEN=
