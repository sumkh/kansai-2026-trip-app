# Copy to .env.production.local and fill in. GITIGNORED — never commit it.
#
# Used by `npm run trip:export -- --prod`, `trip:apply --prod` and
# `npm run doctor` when you want the LIVE database rather than the local stack.
#
# The default without --prod is always local, on purpose: a replan aimed at the
# wrong database is not something you notice until the day it matters.

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Dashboard → Project Settings → API → secret key. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Render dashboard → Environment → TRIP_API_TOKEN (reveal it). Only needed if
# you want to call /api/trip/* with curl.
TRIP_API_TOKEN=
